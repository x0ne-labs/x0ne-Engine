#!/usr/bin/env bash
# The fake VM's cargo: records its arguments, then installs the x0ne-infer this
# test build made ($FAKE_INFER_BIN) where `cargo build --release` puts it.
printf '%s\n' "$*" > "$HOME/cargo.argv"
[ "${1:-}" = build ] && [ -x "${FAKE_INFER_BIN:-}" ] || exit 101
mkdir -p target/release && cp "$FAKE_INFER_BIN" target/release/x0ne-infer
