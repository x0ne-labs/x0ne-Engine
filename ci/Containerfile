# Local CI image for `make ci` (ci/ci.sh). Every input is pinned: base image by
# digest, cargo-deny by release checksum, gitleaks by image digest. The run
# itself has no network; this build is the only step that fetches anything.
#
#   podman build -f ci/Containerfile -t localhost/x0ne-engine-ci:<tag> ci

# Same toolchain as Containerfile and rust-toolchain.toml (rust 1.98.1).
ARG RUST_IMAGE=docker.io/library/rust:1.98.1-slim-bookworm@sha256:ff521445a372125ed4f76e1453a1f8098f2d05332d1601d30db1c1f62757e730
# gitleaks v8.30.1, the digest pinned in .github/workflows/security.yml.
ARG GITLEAKS_IMAGE=docker.io/zricethezav/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f

FROM ${GITLEAKS_IMAGE} AS gitleaks

FROM ${RUST_IMAGE}
ARG CARGO_DENY_VERSION=0.20.2
ARG CARGO_DENY_SHA256=9f12ed4c49936e09b48bf862b595cde2fe64fcbd9d74dfacac6131ca824c8d5f
# bookworm packages, snapshot not pinned: the debian snapshot archive is not
# reachable from here. The base image digest fixes the apt state well enough
# for CI; the release build (x0ne-OS) does not use this image.
# jq: ci/tests/release-verify-tag.sh replays the --jq filters of the release workflow.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl g++ git jq pkg-config python3 \
 && rm -rf /var/lib/apt/lists/* \
 && rustup component add rustfmt clippy \
 && name="cargo-deny-${CARGO_DENY_VERSION}-x86_64-unknown-linux-musl" \
 && curl -fsSLo /tmp/deny.tar.gz "https://github.com/EmbarkStudios/cargo-deny/releases/download/${CARGO_DENY_VERSION}/${name}.tar.gz" \
 && echo "${CARGO_DENY_SHA256}  /tmp/deny.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/deny.tar.gz -C /tmp \
 && install -m 0755 "/tmp/${name}/cargo-deny" /usr/local/cargo/bin/cargo-deny \
 && rm -rf /tmp/deny.tar.gz "/tmp/${name}"
COPY --from=gitleaks /usr/bin/gitleaks /usr/local/bin/gitleaks
ENV CARGO_INCREMENTAL=0 CARGO_NET_OFFLINE=true
LABEL org.opencontainers.image.title="x0ne-engine-ci" \
      org.opencontainers.image.description="Local CI for x0ne-Engine: fmt, clippy, test, doc, cargo-deny, gitleaks. No network at run time."
