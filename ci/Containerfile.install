# A client machine of ci/install-matrix.sh: the distribution's base image (BASE, pinned by
# digest there), plus what ci/tests/installer.sh needs (curl, CA certificates, python3,
# openssl, tar, gzip) and, on Debian, shellcheck. One ordinary user, u. Building it is the
# only step with network; the tests run without.
ARG BASE
FROM ${BASE}
RUN if command -v apt-get >/dev/null 2>&1; then \
      extra=; . /etc/os-release; [ "$ID" = debian ] && extra=shellcheck; \
      apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl ca-certificates python3 openssl tar gzip $extra \
      && rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null 2>&1; then \
      dnf -y install --setopt=install_weak_deps=False curl ca-certificates python3 openssl tar gzip shadow-utils \
      && dnf clean all; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache curl ca-certificates python3 openssl tar gzip; \
    fi \
 && if command -v useradd >/dev/null 2>&1; then useradd -m u; else adduser -D u; fi
USER u
WORKDIR /home/u
